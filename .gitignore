node_modules/
dist/
# artefatos gerados pelo tsc -b
*.tsbuildinfo
vite.config.js
vite.config.d.ts
.env
.env.*
!.env.example
worker/node_modules/
worker/dist/
worker/.env
*.log
.DS_Store
.vscode/
# snapshots/saídas do navegador automatizado (podem conter dados sensíveis)
.playwright-mcp/
# pastas de trabalho do agent-worker (livros em produção)
atelier-work/

# arquivo de skills (instaladas em ~/.claude/skills; não versionar)
skills-livro.zip

# Local Netlify folder
.netlify

# rascunhos de prompt na RAIZ (os versionados ficam em docs/prompts/)
/PROMPT-*.md
*.local

# script de conveniência local do worker (não versionar)
/Iniciar-Worker.bat

# Backups da auditoria antivazamento (conteúdo de livros — não versionar)
worker/audit-backup/

# Backups .orig.bak (auditoria antivazamento) e bytecode python
*.orig.bak
__pycache__/

# Artefato do comando de prontidão (gerado; não versionado)
.prontidao/

# Evidencias de verificacao externa: carregam project id, caminhos de Storage e
# log de execucao. O remoto e PUBLICO — nunca versionar.
.evidencias/

# Prova literaria: carrega project id, sha256 do manuscrito e o relatorio
# editorial do LIVRO. Mesma razao da pasta acima — o remoto e publico.
.prova-literaria/

# Rotulagem humana PREENCHIDA (julgamento do autor sobre trechos da obra).
# O template vazio fica versionado; o arquivo respondido, nao.
calibracao-humana/*.local.csv
calibracao-humana/rotulos-pendentes.csv

# Area temporaria da auditoria: pacotes .tgz do repo inteiro (com o .git dentro)
# e copias de checks/meta. Nao e fonte — os scripts e o historico ficam.
.auditorias/tmp/

# Logs do worker com sufixo (worker.log.1 da rotacao, .v1-legado, .log.err):
# a regra "*.log" acima nao pega nada com sufixo depois do .log
worker.log.*
*.log.err

# Copias .bak de scripts do autostart. A versao anterior ja vive no git —
# manter uma segunda copia versionada e historico duplicado.
*.v1.bak.*

# Lancador gerado pelo instalar-autostart.ps1 (recriado a cada instalacao,
# com o caminho absoluto DESTA maquina dentro)
worker/autostart/worker-hidden.vbs

# Sentinela do disjuntor do wrapper. E estado DESTA maquina: commitado, faria
# o autostart se recusar a subir em qualquer checkout que o recebesse.
worker/worker.STOPPED

# Prints e capturas de tela soltos na raiz
/*.jpeg
/*.jpg
/*.png
